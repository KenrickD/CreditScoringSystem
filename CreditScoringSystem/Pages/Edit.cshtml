@page
@model EditModel
@{
    ViewData["Title"] = "Edit Application";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Edit Credit Application</h2>
        <a asp-page="/Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Application.Id" />
        <input type="hidden" asp-for="Application.CreatedAt" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Personal Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Application.ApplicationNumber" class="form-label"></label>
                        <input asp-for="Application.ApplicationNumber" class="form-control" />
                        <span asp-validation-for="Application.ApplicationNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Application.Name" class="form-label"></label>
                        <input asp-for="Application.Name" class="form-control" />
                        <span asp-validation-for="Application.Name" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Application.BirthPlace" class="form-label"></label>
                        <input asp-for="Application.BirthPlace" class="form-control" />
                        <span asp-validation-for="Application.BirthPlace" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Application.BirthDate" class="form-label"></label>
                        <input asp-for="Application.BirthDate" class="form-control" type="date" />
                        <span asp-validation-for="Application.BirthDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Application.Gender" class="form-label"></label>
                        <select asp-for="Application.Gender" class="form-select">
                            <option value="">-- Select Gender --</option>
                            <option value="Laki-laki">Laki-laki</option>
                            <option value="Perempuan">Perempuan</option>
                        </select>
                        <span asp-validation-for="Application.Gender" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Application.PostalCode" class="form-label"></label>
                        <input asp-for="Application.PostalCode" class="form-control" />
                        <span asp-validation-for="Application.PostalCode" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Application.Address" class="form-label"></label>
                    <textarea asp-for="Application.Address" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Application.Address" class="text-danger"></span>
                </div>
            </div>
        </div>

        <!-- Tabs for Scoring Parameters -->
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Scoring Parameters</h5>
            </div>
            <div class="card-body">
                <ul class="nav nav-tabs" id="scoringTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab1-tab" data-bs-toggle="tab" data-bs-target="#tab1" 
                                type="button" role="tab" aria-controls="tab1" aria-selected="true">
                            Tab 1
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab2-tab" data-bs-toggle="tab" data-bs-target="#tab2" 
                                type="button" role="tab" aria-controls="tab2" aria-selected="false">
                            Tab 2
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab3-tab" data-bs-toggle="tab" data-bs-target="#tab3" 
                                type="button" role="tab" aria-controls="tab3" aria-selected="false">
                            Tab 3
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab4-tab" data-bs-toggle="tab" data-bs-target="#tab4" 
                                type="button" role="tab" aria-controls="tab4" aria-selected="false">
                            Tab 4
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab5-tab" data-bs-toggle="tab" data-bs-target="#tab5" 
                                type="button" role="tab" aria-controls="tab5" aria-selected="false">
                            Tab 5
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab6-tab" data-bs-toggle="tab" data-bs-target="#tab6" 
                                type="button" role="tab" aria-controls="tab6" aria-selected="false">
                            Tab 6
                        </button>
                    </li>
                </ul>

                <div class="tab-content mt-3" id="scoringTabsContent">
                    <!-- Tab 1 Content -->
                    <div class="tab-pane fade show active" id="tab1" role="tabpanel" aria-labelledby="tab1-tab">
                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.AgeRange" class="form-label fw-bold"></label>
                            <select asp-for="Application.AgeRange" class="form-select">
                                <option value="">-- Select Age Range --</option>
                                <option value="56-65">56-65 tahun</option>
                                <option value="21-30">21-30 tahun</option>
                                <option value="31-45">31-45 tahun</option>
                                <option value="46-55">46-55 tahun</option>
                            </select>
                            <span asp-validation-for="Application.AgeRange" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.AgePlusTenor" class="form-label fw-bold"></label>
                            <select asp-for="Application.AgePlusTenor" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="Above">Diatas ketentuan</option>
                                <option value="Below">Dibawah ketentuan</option>
                            </select>
                            <span asp-validation-for="Application.AgePlusTenor" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.MaritalStatus" class="form-label fw-bold"></label>
                            <select asp-for="Application.MaritalStatus" class="form-select">
                                <option value="">-- Select Marital Status --</option>
                                <option value="SingleMoreThan2">Belum Kawin dengan > 2 tanggungan</option>
                                <option value="SingleLessEqual2">Belum kawin dengan <= 2 tanggungan</option>
                                <option value="Single0">Belum kawin dengan 0 tanggungan</option>
                                <option value="MarriedMoreThan2">Kawin dengan > 2 tanggungan</option>
                                <option value="MarriedLessEqual2">Kawin dengan <= 2 tanggungan</option>
                            </select>
                            <span asp-validation-for="Application.MaritalStatus" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.Education" class="form-label fw-bold"></label>
                            <select asp-for="Application.Education" class="form-select">
                                <option value="">-- Select Education Level --</option>
                                <option value="HighSchool">SMA atau dibawahnya</option>
                                <option value="Diploma">D1, D2, D3, D4</option>
                                <option value="Bachelor">S1</option>
                                <option value="Master">Master atau diatasnya</option>
                            </select>
                            <span asp-validation-for="Application.Education" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Tab 2 Content -->
                    <div class="tab-pane fade" id="tab2" role="tabpanel" aria-labelledby="tab2-tab">
                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.ResidenceAddressMatch" class="form-label fw-bold"></label>
                            <select asp-for="Application.ResidenceAddressMatch" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="NotMatch">Tidak sesuai dengan data bank</option>
                                <option value="Match">Sesuai dengan data bank</option>
                            </select>
                            <span asp-validation-for="Application.ResidenceAddressMatch" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.ResidenceOwnership" class="form-label fw-bold"></label>
                            <select asp-for="Application.ResidenceOwnership" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="Others">Lain-Lain</option>
                                <option value="Rent">Sewa/Kontrak</option>
                                <option value="OwnInstallment">Milik sendiri masih diangsur</option>
                                <option value="Own">Milik Sendiri</option>
                            </select>
                            <span asp-validation-for="Application.ResidenceOwnership" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.ResidenceDuration" class="form-label fw-bold"></label>
                            <select asp-for="Application.ResidenceDuration" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="LessThan2"><= 2 tahun</option>
                                <option value="2to5">2-5 tahun</option>
                                <option value="5to8">5-8 tahun</option>
                                <option value="MoreThan8">> 8 Tahun</option>
                            </select>
                            <span asp-validation-for="Application.ResidenceDuration" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Tab 3 Content -->
                    <div class="tab-pane fade" id="tab3" role="tabpanel" aria-labelledby="tab3-tab">
                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.CompanyCategory" class="form-label fw-bold"></label>
                            <select asp-for="Application.CompanyCategory" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="Government">Lembaga Departemen</option>
                                <option value="BUMD">BUMD</option>
                                <option value="PrivateNoRating">SWASTA tidak punya rating</option>
                                <option value="PrivateWithRating">SWASTA dengan rating</option>
                                <option value="PrivateCat1">SWASTA Katergori I</option>
                                <option value="PrivateCat2">SWASTA Kategori II</option>
                                <option value="PrivateCat3">SWASTA Kategori III</option>
                            </select>
                            <span asp-validation-for="Application.CompanyCategory" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.JobPosition" class="form-label fw-bold"></label>
                            <select asp-for="Application.JobPosition" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="Staff">Staff</option>
                                <option value="Director">Direktur</option>
                                <option value="Commissioner">Komisaris</option>
                            </select>
                            <span asp-validation-for="Application.JobPosition" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.WorkDuration" class="form-label fw-bold"></label>
                            <select asp-for="Application.WorkDuration" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="LessThan2"><= 2 Tahun</option>
                                <option value="2to5">2 - 5 Tahun</option>
                                <option value="5to10">5 - 10 Tahun</option>
                                <option value="MoreThan10">> 10 Tahun</option>
                            </select>
                            <span asp-validation-for="Application.WorkDuration" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.TakeHomePay" class="form-label fw-bold"></label>
                            <select asp-for="Application.TakeHomePay" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="LessThan10"><= Rp 10 juta</option>
                                <option value="10to25">Rp 10 - Rp 25 juta</option>
                                <option value="25to50">Rp 25 - Rp 50 juta</option>
                                <option value="MoreThan50">> Rp 50 juta</option>
                            </select>
                            <span asp-validation-for="Application.TakeHomePay" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Tab 4 Content -->
                    <div class="tab-pane fade" id="tab4" role="tabpanel" aria-labelledby="tab4-tab">
                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.BankAccount" class="form-label fw-bold"></label>
                            <select asp-for="Application.BankAccount" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="None">Tidak ada</option>
                                <option value="Savings">Tabungan</option>
                                <option value="Checking">Giro</option>
                                <option value="SavingsCheckingDeposit">Tabungan/Giro + Deposito</option>
                            </select>
                            <span asp-validation-for="Application.BankAccount" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.AverageBalance" class="form-label fw-bold"></label>
                            <select asp-for="Application.AverageBalance" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="LessThan10"><= Rp 10 juta</option>
                                <option value="10to25">Rp 10 - Rp 25 juta</option>
                                <option value="25to50">Rp 25 - Rp 50 juta</option>
                                <option value="MoreThan50">> Rp 50 juta</option>
                            </select>
                            <span asp-validation-for="Application.AverageBalance" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.PaymentTrackRecord" class="form-label fw-bold"></label>
                            <select asp-for="Application.PaymentTrackRecord" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="NewBorrower">Peminjam baru</option>
                                <option value="LateButtSmooth">Angsuran terlambat tapi lancar</option>
                                <option value="OnTime">Angsuran tepat waktu</option>
                            </select>
                            <span asp-validation-for="Application.PaymentTrackRecord" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.SlikData" class="form-label fw-bold"></label>
                            <select asp-for="Application.SlikData" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="Col3to5">Kolektibilitas 3 sd 5</option>
                                <option value="ArrearsLess3">Ada tunggakan < 3 bulan</option>
                                <option value="NoFacility">Tidak ada fasilitas</option>
                                <option value="Smooth">Lancar</option>
                            </select>
                            <span asp-validation-for="Application.SlikData" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.CreditCardOwnership" class="form-label fw-bold"></label>
                            <select asp-for="Application.CreditCardOwnership" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="None">Tidak Ada</option>
                                <option value="Basic">Basic</option>
                                <option value="Gold">Gold</option>
                                <option value="Platinum">Platinum atau diatasnya</option>
                            </select>
                            <span asp-validation-for="Application.CreditCardOwnership" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Tab 5 Content -->
                    <div class="tab-pane fade" id="tab5" role="tabpanel" aria-labelledby="tab5-tab">
                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.Tenor" class="form-label fw-bold"></label>
                            <select asp-for="Application.Tenor" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="MoreThan15">> 15 Tahun</option>
                                <option value="10to15">10 - 15 Tahun</option>
                                <option value="5to10">5 - 10 Tahun</option>
                                <option value="LessThan5"><= 5 Tahun</option>
                            </select>
                            <span asp-validation-for="Application.Tenor" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.DebtServiceRatio" class="form-label fw-bold"></label>
                            <select asp-for="Application.DebtServiceRatio" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="MoreThan50">> 50%</option>
                                <option value="40to50">40 - 50%</option>
                                <option value="30to40">30 - 40%</option>
                                <option value="LessThan30"><= 30%</option>
                            </select>
                            <span asp-validation-for="Application.DebtServiceRatio" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Tab 6 Content -->
                    <div class="tab-pane fade" id="tab6" role="tabpanel" aria-labelledby="tab6-tab">
                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.AppraisalResult" class="form-label fw-bold"></label>
                            <select asp-for="Application.AppraisalResult" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="NotRecommended">Tidak Direkomendasikan</option>
                                <option value="Marketable">Marketable</option>
                            </select>
                            <span asp-validation-for="Application.AppraisalResult" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.BuildingArea" class="form-label fw-bold"></label>
                            <select asp-for="Application.BuildingArea" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="MoreThan200">> 200 M2</option>
                                <option value="100to200">100 - 200 M2</option>
                                <option value="45to100">45 - 100 M2</option>
                                <option value="LessThan45"><= 45 M2</option>
                            </select>
                            <span asp-validation-for="Application.BuildingArea" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.FinancingPurpose" class="form-label fw-bold"></label>
                            <select asp-for="Application.FinancingPurpose" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="Others">Lain-Lain</option>
                                <option value="Rent">Disewakan/Investasi</option>
                                <option value="Renovation">Renovasi</option>
                                <option value="FirstOwn">Pertama & Ditempati Sendiri</option>
                            </select>
                            <span asp-validation-for="Application.FinancingPurpose" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded">
                            <label asp-for="Application.LTV" class="form-label fw-bold"></label>
                            <select asp-for="Application.LTV" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="MoreThan100">LTV > 100%</option>
                                <option value="MoreThan90">LTV > 90%</option>
                                <option value="MoreThan80">LTV > 80%</option>
                                <option value="MoreThan70">LTV > 70%</option>
                                <option value="LessThan70">LTV <= 70%</option>
                            </select>
                            <span asp-validation-for="Application.LTV" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex justify-content-between">
            <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-success btn-lg">
                <i class="bi bi-save"></i> Recalculate & Update
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">