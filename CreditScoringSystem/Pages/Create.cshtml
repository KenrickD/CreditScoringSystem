@page
@model CreateModel
@{
    ViewData["Title"] = "Add New Application";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Add New Credit Application</h2>
        <a asp-page="/Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <form method="post">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Personal Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Application.ApplicationNumber" class="form-label"></label>
                        <input asp-for="Application.ApplicationNumber" class="form-control" />
                        <span asp-validation-for="Application.ApplicationNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Application.Name" class="form-label"></label>
                        <input asp-for="Application.Name" class="form-control" />
                        <span asp-validation-for="Application.Name" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Application.BirthPlace" class="form-label"></label>
                        <input asp-for="Application.BirthPlace" class="form-control" />
                        <span asp-validation-for="Application.BirthPlace" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Application.BirthDate" class="form-label"></label>
                        <input asp-for="Application.BirthDate" class="form-control" type="date" />
                        <span asp-validation-for="Application.BirthDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Application.Gender" class="form-label"></label>
                        <select asp-for="Application.Gender" class="form-select">
                            <option value="">-- Select Gender --</option>
                            <option value="Laki-laki">Laki-laki</option>
                            <option value="Perempuan">Perempuan</option>
                        </select>
                        <span asp-validation-for="Application.Gender" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Application.PostalCode" class="form-label"></label>
                        <input asp-for="Application.PostalCode" class="form-control" />
                        <span asp-validation-for="Application.PostalCode" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Application.Address" class="form-label"></label>
                    <textarea asp-for="Application.Address" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Application.Address" class="text-danger"></span>
                </div>
            </div>
        </div>

        <!-- Tabs for Scoring Parameters -->
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Scoring Parameters</h5>
            </div>
            <div class="card-body">
                <ul class="nav nav-tabs" id="scoringTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab1-tab" data-bs-toggle="tab" data-bs-target="#tab1" 
                                type="button" role="tab" aria-controls="tab1" aria-selected="true">
                            Tab 1 (Weight: 5%)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link disabled" id="tab2-tab" type="button" role="tab">
                            Tab 2 (Coming Soon)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link disabled" id="tab3-tab" type="button" role="tab">
                            Tab 3 (Coming Soon)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link disabled" id="tab4-tab" type="button" role="tab">
                            Tab 4 (Coming Soon)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link disabled" id="tab5-tab" type="button" role="tab">
                            Tab 5 (Coming Soon)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link disabled" id="tab6-tab" type="button" role="tab">
                            Tab 6 (Coming Soon)
                        </button>
                    </li>
                </ul>

                <div class="tab-content mt-3" id="scoringTabsContent">
                    <!-- Tab 1 Content -->
                    <div class="tab-pane fade show active" id="tab1" role="tabpanel" aria-labelledby="tab1-tab">
                        <div class="alert alert-info">
                            <strong>Tab 1 Weight: 5%</strong><br/>
                            Fill in all parameters below to calculate the score for this tab.
                        </div>

                        <!-- Parameter 1: Umur Pemohon (Weight: 30%) -->
                        <div class="mb-4 p-3 border rounded">
                            <label class="form-label fw-bold">1. Umur Pemohon (Weight: 30%)</label>
                            <select asp-for="Application.AgeRange" class="form-select">
                                <option value="">-- Select Age Range --</option>
                                <option value="56-65">56-65 tahun (Score: 25)</option>
                                <option value="21-30">21-30 tahun (Score: 50)</option>
                                <option value="31-45">31-45 tahun (Score: 100)</option>
                                <option value="46-55">46-55 tahun (Score: 75)</option>
                            </select>
                            <span asp-validation-for="Application.AgeRange" class="text-danger"></span>
                        </div>

                        <!-- Parameter 2: Umur Pemohon + Tenor (Weight: 10%) -->
                        <div class="mb-4 p-3 border rounded">
                            <label class="form-label fw-bold">2. Umur Pemohon + Tenor (Weight: 10%)</label>
                            <select asp-for="Application.AgePlusTenor" class="form-select">
                                <option value="">-- Select Option --</option>
                                <option value="Above">Diatas ketentuan (Score: 25)</option>
                                <option value="Below">Dibawah ketentuan (Score: 100)</option>
                            </select>
                            <span asp-validation-for="Application.AgePlusTenor" class="text-danger"></span>
                        </div>

                        <!-- Parameter 3: Status Perkawinan (Weight: 40%) -->
                        <div class="mb-4 p-3 border rounded">
                            <label class="form-label fw-bold">3. Status Perkawinan (Weight: 40%)</label>
                            <select asp-for="Application.MaritalStatus" class="form-select">
                                <option value="">-- Select Marital Status --</option>
                                <option value="SingleMoreThan2">Belum Kawin dengan > 2 tanggungan (Score: 25)</option>
                                <option value="SingleLessEqual2">Belum kawin dengan <= 2 tanggungan (Score: 45)</option>
                                <option value="Single0">Belum kawin dengan 0 tanggungan (Score: 65)</option>
                                <option value="MarriedMoreThan2">Kawin dengan > 2 tanggungan (Score: 85)</option>
                                <option value="MarriedLessEqual2">Kawin dengan <= 2 tanggungan (Score: 100)</option>
                            </select>
                            <span asp-validation-for="Application.MaritalStatus" class="text-danger"></span>
                        </div>

                        <!-- Parameter 4: Pendidikan (Weight: 20%) -->
                        <div class="mb-4 p-3 border rounded">
                            <label class="form-label fw-bold">4. Pendidikan (Weight: 20%)</label>
                            <select asp-for="Application.Education" class="form-select">
                                <option value="">-- Select Education Level --</option>
                                <option value="HighSchool">SMA atau dibawahnya (Score: 25)</option>
                                <option value="Diploma">D1, D2, D3, D4 (Score: 50)</option>
                                <option value="Bachelor">S1 (Score: 75)</option>
                                <option value="Master">Master atau diatasnya (Score: 100)</option>
                            </select>
                            <span asp-validation-for="Application.Education" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex justify-content-between">
            <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-calculator"></i> Calculate Score & Save
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">